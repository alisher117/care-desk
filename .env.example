# Postgres. An empty database is enough; `npm run migrate` creates the schema.
CARE_DESK_DATABASE_URL=postgres://care_desk:change-me@localhost:5432/care_desk

# Public base URL, used for links in notification emails.
APP_URL=http://localhost:3000

# Email (optional). Without SMTP_HOST, notifications are logged and skipped.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Care Desk <no-reply@example.com>"

# Inbox that gets a message for every new ticket (optional).
CARE_DESK_NOTIFY_EMAIL=

# No-auth shell: who every visitor is treated as. See src/care-desk/host/identity-adapter.ts.
CARE_DESK_DEV_REQUESTER_NAME="Demo Requester"
CARE_DESK_DEV_REQUESTER_EMAIL=
CARE_DESK_DEV_OPERATOR_NAME="Demo Operator"
CARE_DESK_DEV_OPERATOR_EMAIL=
